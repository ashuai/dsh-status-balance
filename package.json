{
  "name": "dsh-status-balance",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Minimal DeepSeek balance + session spend pill for the DeepSeek Harness Web UI, with a click-to-open today ledger.",
  "license": "MIT",
  "author": "ashuai",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ashuai/dsh-status-balance.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
